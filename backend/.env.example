# Upstash Redis (see infrastructure-design.md). Get these from the Upstash console or the
# Vercel Upstash integration — never commit real values.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-real-token

# CORS: must match the Frontend Web App's deployed origin exactly (no trailing slash).
FRONTEND_ORIGIN=http://localhost:5173
